NODE_ENV=development
COMPOSE_PROJECT_NAME=cs2-platform

# Database
POSTGRES_DB=cs2_platform
POSTGRES_USER=cs2
POSTGRES_PASSWORD=cs2_secure_password
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# API
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
API_CORS_ORIGIN=http://localhost:3000

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_HTTP_URL=http://localhost:4000
NEXT_PUBLIC_API_WS_URL=http://localhost:4000

# Security
JWT_ACCESS_SECRET=replace_me_access
JWT_REFRESH_SECRET=replace_me_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# EOS
EOS_API_BASE_URL=https://eos.greymass.com
